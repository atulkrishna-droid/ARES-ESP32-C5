# ARES Platform Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database: SQLite for zero-config local testing, PostgreSQL for production
# SQLite: sqlite+aiosqlite:///./ares.db (async) or sqlite:///./ares.db
# PostgreSQL: postgresql+psycopg2://ares_user:ares_pass@localhost:5432/ares_db
DATABASE_URL=sqlite:///./ares.db

# Cryptographic and JWT Configuration
JWT_SECRET=super-secret-ares-cryptographic-signing-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Evidence Storage Configuration
EVIDENCE_STORAGE_PATH=./data/evidence
MAX_EVIDENCE_SIZE_MB=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Redis (Optional)
REDIS_URL=
