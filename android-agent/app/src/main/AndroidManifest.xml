<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential Network Permissions -->
    <!-- Required: Establish TLS 1.3 encrypted connection to ARES backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Required: Detect network interface indicators (Wi-Fi, Cellular, VPN presence) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground Service Permissions -->
    <!-- Required: Maintain active assessment state and periodic heartbeat without sleep killing -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification Permission (Android 13+ / API 33+) -->
    <!-- Transparency requirement: Persistent notification while assessment is active -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package Query Declarations for Application Inventory -->
    <!-- On Android 11+ (API 30+), querying all packages requires QUERY_ALL_PACKAGES permission
         or explicit intent queries. If denied or ungranted, inventory gracefully falls back
         to queryIntentActivities / common launcher queries. -->
    <uses-permission 
        android:name="android.permission.QUERY_ALL_PACKAGES" 
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".AresApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AresAgent"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main Operator / Diagnostics UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ARES Agent Background Service -->
        <service
            android:name=".service.AresAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Authorized diagnostic assessment telemetry and case-scoped security auditing." />
        </service>

    </application>

</manifest>
